# ── Supabase ──────────────────────────────────────────────────────────────
# 1. Create a project at https://supabase.com
# 2. Copy this file to `.env` (or `.env.local`)
# 3. Paste the values from: Project Settings → API
#
# The anon/public key is meant to be used in the browser — Row Level Security
# (see supabase/schema.sql) is what protects your data, not the key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Google Analytics 4 measurement ID (optional; defaults to the code constant)
VITE_GA_MEASUREMENT_ID=G-PZ28S5JRM4

# Google Tag Manager container ID (optional; defaults to the code constant)
VITE_GTM_ID=GTM-T8HJWDSD

# ── Toss Payments ─────────────────────────────────────────────────────────
# 결제창(카드) 연동용 클라이언트 키. 토스페이먼츠 대시보드 → 개발자센터 → API 키.
# 미설정 시 공개 테스트 키로 동작합니다(실제 청구 없음). 심사·운영 전 본인 키로 교체.
# 클라이언트 키는 브라우저 노출 가능(공개키). 시크릿 키는 절대 프론트에 두지 마세요.
VITE_TOSS_CLIENT_KEY=test_ck_D5GePWvyJnrK0W0k6q8gLzN97Eoq
