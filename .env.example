# ── Supabase ──────────────────────────────────────────────────────────────
# 1. Create a project at https://supabase.com
# 2. Copy this file to `.env` (or `.env.local`)
# 3. Paste the values from: Project Settings → API
#
# The anon/public key is meant to be used in the browser — Row Level Security
# (see supabase/schema.sql) is what protects your data, not the key.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
